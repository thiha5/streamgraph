<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="co.thibi.extensions.streamgraph" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Renders a stream graph (ThemeRiver) from a Date, Category and Measure, with optional Color, Detail and Tooltip fields.</description>
    <author name="Thibi" email="thiha@thibi.co" organization="Thibi" website="https://thibi.co"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>http://localhost:8765/streamgraph.html</url>
    </source-location>
    <icon/>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
    <encoding id="date">
      <display-name>Date</display-name>
      <data-spec>
        <data-type>temporal</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
        <role-type>continuous-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-d"/>
      <tooltip>Date field that drives the horizontal axis of the stream.</tooltip>
    </encoding>
    <encoding id="category">
      <display-name>Category</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-c"/>
      <tooltip>Dimension that splits the stream into individual bands.</tooltip>
    </encoding>
    <encoding id="measure">
      <display-name>Measure</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-m"/>
      <tooltip>Measure that sets the thickness of each band.</tooltip>
    </encoding>
    <encoding id="color">
      <display-name>Color</display-name>
      <fields max-count="1"/>
      <encoding-icon token="color"/>
      <tooltip>Optional field to color the bands by. Defaults to Category when left empty.</tooltip>
    </encoding>
    <!--
      Tableau automatically gives every viz extension a Detail and a Tooltip
      encoding tile on the Marks card, and a worksheet-extension may declare
      at most four custom encodings (we're already at four above), so Detail
      and Tooltip are intentionally not redeclared here.
    -->
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Stream Graph</text>
    </resource>
  </resources>
</manifest>
